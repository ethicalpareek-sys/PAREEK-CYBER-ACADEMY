<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400" width="1200" height="400">
  <defs>
    <!-- Background gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#04060a"/>
      <stop offset="50%" stop-color="#0a1218"/>
      <stop offset="100%" stop-color="#020406"/>
    </linearGradient>

    <!-- Cyber accent gradient -->
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00ffd1"/>
      <stop offset="50%" stop-color="#3fe0c8"/>
      <stop offset="100%" stop-color="#5b8cff"/>
    </linearGradient>

    <!-- Text glow gradient -->
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#8fe9da"/>
    </linearGradient>

    <!-- Radial glow -->
    <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#00ffd1" stop-opacity="0.6"/>
      <stop offset="40%" stop-color="#00ffd1" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#00ffd1" stop-opacity="0"/>
    </radialGradient>

    <radialGradient id="blueGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#5b8cff" stop-opacity="0.5"/>
      <stop offset="100%" stop-color="#5b8cff" stop-opacity="0"/>
    </radialGradient>

    <!-- Shadow filter for 3D depth -->
    <filter id="textShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="3"/>
      <feOffset dx="0" dy="4" result="offsetblur"/>
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.7"/>
      </feComponentTransfer>
      <feMerge>
        <feMergeNode/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Glow filter -->
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Strong glow -->
    <filter id="strongGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="12" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- Grid pattern -->
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#00ffd1" stroke-width="0.5" stroke-opacity="0.08"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="1200" height="400" fill="url(#bgGrad)"/>

  <!-- Grid overlay (3D floor effect) -->
  <rect width="1200" height="400" fill="url(#grid)" opacity="0.6"/>

  <!-- Perspective grid lines (bottom — 3D floor illusion) -->
  <g opacity="0.25" stroke="#00ffd1" stroke-width="0.8" fill="none">
    <line x1="0" y1="400" x2="600" y2="280"/>
    <line x1="1200" y1="400" x2="600" y2="280"/>
    <line x1="200" y1="400" x2="600" y2="280"/>
    <line x1="1000" y1="400" x2="600" y2="280"/>
    <line x1="400" y1="400" x2="600" y2="280"/>
    <line x1="800" y1="400" x2="600" y2="280"/>
  </g>

  <!-- Radial glows -->
  <ellipse cx="600" cy="200" rx="500" ry="200" fill="url(#coreGlow)"/>
  <ellipse cx="200" cy="100" rx="300" ry="150" fill="url(#blueGlow)"/>
  <ellipse cx="1000" cy="320" rx="300" ry="150" fill="url(#blueGlow)"/>

  <!-- Rotating rings (3D illusion) -->
  <g opacity="0.35">
    <ellipse cx="600" cy="200" rx="340" ry="90" fill="none" stroke="#00ffd1" stroke-width="1.2"/>
    <ellipse cx="600" cy="200" rx="280" ry="70" fill="none" stroke="#3fe0c8" stroke-width="0.8" transform="rotate(15 600 200)"/>
    <ellipse cx="600" cy="200" rx="220" ry="55" fill="none" stroke="#5b8cff" stroke-width="0.6" transform="rotate(-20 600 200)"/>
  </g>

  <!-- Corner brackets -->
  <g stroke="#00ffd1" stroke-width="2" fill="none" opacity="0.7">
    <path d="M 30 60 L 30 30 L 60 30"/>
    <path d="M 1140 30 L 1170 30 L 1170 60"/>
    <path d="M 30 340 L 30 370 L 60 370"/>
    <path d="M 1170 340 L 1170 370 L 1140 370"/>
  </g>

  <!-- Top HUD text -->
  <text x="60" y="55" font-family="'JetBrains Mono', monospace" font-size="11" fill="#00ffd1" letter-spacing="4" opacity="0.85">◈ SYSTEM · ONLINE</text>
  <text x="1140" y="55" font-family="'JetBrains Mono', monospace" font-size="11" fill="#8fa2b3" letter-spacing="4" text-anchor="end" opacity="0.85">PCA · 2025</text>

  <!-- Main Title with 3D effect (layered shadow) -->
  <g filter="url(#textShadow)">
    <!-- Depth shadow copies -->
    <text x="600" y="188" font-family="'Space Grotesk', 'Anton', sans-serif" font-size="88" font-weight="900" fill="#000000" text-anchor="middle" letter-spacing="2" opacity="0.5">PAREEK</text>
    <text x="600" y="192" font-family="'Space Grotesk', 'Anton', sans-serif" font-size="88" font-weight="900" fill="#001a18" text-anchor="middle" letter-spacing="2" opacity="0.6">PAREEK</text>
    <text x="600" y="196" font-family="'Space Grotesk', 'Anton', sans-serif" font-size="88" font-weight="900" fill="#002a26" text-anchor="middle" letter-spacing="2" opacity="0.7">PAREEK</text>
  </g>

  <!-- Main text with glow -->
  <text x="600" y="192" font-family="'Space Grotesk', 'Anton', sans-serif" font-size="88" font-weight="900" fill="url(#textGrad)" text-anchor="middle" letter-spacing="2" filter="url(#strongGlow)">PAREEK</text>

  <!-- Subtitle -->
  <g filter="url(#glow)">
    <text x="600" y="262" font-family="'Space Grotesk', sans-serif" font-size="46" font-weight="700" fill="#3fe0c8" text-anchor="middle" letter-spacing="8">CYBER ACADEMY</text>
  </g>

  <!-- Tagline with accents -->
  <text x="600" y="312" font-family="'JetBrains Mono', monospace" font-size="15" fill="#e2edf5" text-anchor="middle" letter-spacing="10" opacity="0.95">LEARN • BUILD • DEFEND</text>

  <!-- Bottom line -->
  <text x="600" y="352" font-family="'JetBrains Mono', monospace" font-size="10" fill="#5f7182" text-anchor="middle" letter-spacing="6">◈ AUTHORIZED LABS · ORIGINAL CTF · ETHICAL SECURITY ◈</text>

  <!-- Decorative side elements -->
  <g opacity="0.5">
    <circle cx="140" cy="200" r="3" fill="#00ffd1"/>
    <circle cx="1060" cy="200" r="3" fill="#00ffd1"/>
    <line x1="150" y1="200" x2="220" y2="200" stroke="#00ffd1" stroke-width="0.8"/>
    <line x1="980" y1="200" x2="1050" y2="200" stroke="#00ffd1" stroke-width="0.8"/>
  </g>

  <!-- Animated-style pulse dots (static but gives motion feel) -->
  <g opacity="0.6">
    <circle cx="80" cy="380" r="2" fill="#3fe0c8"/>
    <circle cx="100" cy="380" r="2" fill="#3fe0c8" opacity="0.6"/>
    <circle cx="120" cy="380" r="2" fill="#3fe0c8" opacity="0.3"/>
    <circle cx="1100" cy="380" r="2" fill="#5b8cff"/>
    <circle cx="1120" cy="380" r="2" fill="#5b8cff" opacity="0.6"/>
    <circle cx="1140" cy="380" r="2" fill="#5b8cff" opacity="0.3"/>
  </g>
</svg>
